# Sentinel environment configuration
# Copy this file to .env and fill in the values you need.
# The core detection engine works with zero API keys — everything below is optional.

# --- Optional: LLM-assisted reasoning (choose one) ---
# Only needed if you run with --use-llm
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Caps total LLM token spend per run
SENTINEL_LLM_TOKEN_BUDGET=10000

# --- Logging ---
SENTINEL_ENV=development
LOG_LEVEL=INFO

# --- Storage ---
SENTINEL_DB_PATH=./data/sentinel.db